  "text": "{\"version\":\"6.9\",\"hitCount\":1,\"request\":{\"queryString\":\"EXT_ID:40011559\",\"resultType\":\"core\",\"cursorMark\":\"*\",\"pageSize\":25,\"sort\":\"\",\"synonym\":false},\"resultList\":{\"result\":[{\"id\":\"40011559\",\"source\":\"MED\",\"pmid\":\"40011559\",\"pmcid\":\"PMC11906366\",\"fullTextIdList\":{\"fullTextId\":[\"PMC11906366\"]},\"doi\":\"10.1038/s41556-025-01626-9\",\"title\":\"Decoding heterogeneous single-cell perturbation responses.\",\"authorString\":\"Song B, Liu D, Dai W, McMyn NF, Wang Q, Yang D, Krejci A, Vasilyev A, Untermoser N, Loregger A, Song D, Williams B, Rosen B, Cheng X, Chao L, Kale HT, Zhang H, Diao Y, Bürckstümmer T, Siliciano JD, Li JJ, Siliciano RF, Huangfu D, Li W.\",\"authorList\":{\"author\":[{\"fullName\":\"Song B\",\"lastName\":\"Song\",\"firstName\":\"Bicna\",\"initials\":\"B\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0001-6701-777X\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Center for Genetic Medicine Research, Children's National Hospital, Washington, DC, USA.\"},{\"affiliation\":\"Department of Genomics and Precision Medicine, George Washington University, Washington, DC, USA.\"}]}},{\"fullName\":\"Liu D\",\"lastName\":\"Liu\",\"firstName\":\"Dingyu\",\"initials\":\"D\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Developmental Biology Program, Sloan Kettering Institute, New York City, NY, USA.\"},{\"affiliation\":\"Louis V. Gerstner Jr. Graduate School of Biomedical Sciences, Memorial Sloan Kettering Cancer Center, New York City, NY, USA.\"}]}},{\"fullName\":\"Dai W\",\"lastName\":\"Dai\",\"firstName\":\"Weiwei\",\"initials\":\"W\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Medicine, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"},{\"affiliation\":\"Howard Hughes Medical Institute, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"}]}},{\"fullName\"