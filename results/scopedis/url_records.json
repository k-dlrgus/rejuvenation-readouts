t\":{\"authorAffiliation\":[{\"affiliation\":\"Bioinformatics Interdepartmental PhD Program, University of California, Los Angeles, CA, USA.\"},{\"affiliation\":\"Department of Genetics and Genome Sciences, University of Connecticut Health Center, Farmington, CT, USA.\"}]}},{\"fullName\":\"Williams B\",\"lastName\":\"Williams\",\"firstName\":\"Breanna\",\"initials\":\"B\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Developmental Biology Program, Sloan Kettering Institute, New York City, NY, USA.\"}]}},{\"fullName\":\"Rosen B\",\"lastName\":\"Rosen\",\"firstName\":\"Bess\",\"initials\":\"B\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Developmental Biology Program, Sloan Kettering Institute, New York City, NY, USA.\"},{\"affiliation\":\"Weill Cornell Graduate School of Medical Sciences, Weill Cornell Medicine, New York, NY, USA.\"}]}},{\"fullName\":\"Cheng X\",\"lastName\":\"Cheng\",\"firstName\":\"Xiaolong\",\"initials\":\"X\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Center for Genetic Medicine Research, Children's National Hospital, Washington, DC, USA.\"},{\"affiliation\":\"Department of Genomics and Precision Medicine, George Washington University, Washington, DC, USA.\"}]}},{\"fullName\":\"Chao L\",\"lastName\":\"Chao\",\"firstName\":\"Lumen\",\"initials\":\"L\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-9057-6585\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Center for Genetic Medicine Research, Children's National Hospital, Washington, DC, USA.\"},{\"affiliation\":\"Department of Genomics and Precision Medicine, George Washington University, Washington, DC, USA.\"}]}},{\"fullName\":\"Kale HT\",\"lastName\":\"Kale\",\"firstName\":\"Hanuman T\",\"initials\":\"HT\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Developmental Biology Program, Sloan Kettering Institute, New York City, NY, USA.\"}]}},{\"fullName\":\"Zhang H\",\"lastName\":\"Zhang\",\"firstName\":\"Hao\",\"initials\":\"H\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Medicine, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"}]}},{\"fullName\":\"Diao Y\",\"lastName\":\"Diao\",\"firstName\":\"Yarui\",\"initials\":\"Y\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0001-5842-4082\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Cell Biology, Duke University Medical Center, Durham, NC, USA.\"}]}},{\"fullName\":\"Bürckstümmer T\",\"lastName\":\"Bürckstümmer\",\"firstName\":\"Tilmann\",\"initials\":\"T\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Myllia Biotechnology GmbH, Vienna, Austria.\"}]}},{\"fullName\":\"Siliciano JD\",\"lastName\":\"Siliciano\",\"firstName\":\"Janet D\",\"initials\":\"JD\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Medicine, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"}]}},{\"fullName\":\"Li JJ\",\"lastName\":\"Li\",\"firstName\":\"Jingyi Jessica\",\"initials\":\"JJ\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-9288-5648\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Statistics and Data Science, University of California, Los Angeles, CA, USA.\"},{\"affiliation\":\"Bioinformatics Interdepartmental PhD Program, University of California, Los Angeles, CA, USA.\"},{\"affiliation\":\"Department of Human Genetics, University of California, Los Angeles, CA, USA.\"},{\"affiliation\":\"Department of Biostatistics, University of California, Los Angeles, CA, USA.\"},{\"affiliation\":\"Department of Computational Medicine, University of California, Los Angeles, CA, USA.\"}]}},{\"fullName\":\"Siliciano RF\",\"lastName\":\"Siliciano\",\"firstName\":\"Robert F\",\"initials\":\"RF\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-1764-1993\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Medicine, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"},{\"affiliation\":\"Howard Hughes Medical Institute, Johns Hopkins University School of Medicine, Baltimore, MD, USA.\"}]}},{\"fullName\":\"Huangfu D\",\"lastName\":\"Huangfu\",\"firstName\":\"Danwei\",\"initials\":\"D\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-1145-6199\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Developmental Biology Program, Sloan Kettering Institute, New York City, NY, USA.\"}]}},{\"fullName\":\"Li W\",\"lastName\":\"Li\",\"firstName\":\"Wei\",\"initials\":\"W\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-2163-7903\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Center for Genetic Medicine Research, Children's National Hospital, Washington, DC, USA. wli2@childrensnational.org.\"},{\"affiliation\":\"Department of Genomics and Precision Medicine, George Washington University, Washington, DC, USA. wli2@childrensnational.org.\"}]}}]},\"authorIdList\":{\"authorId\":[{\"type\":\"ORCID\",\"value\":\"0000-0001-5842-4082\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-6125-3480\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-6701-777X\"},{\"type\":\"ORCID\",\"value\":\"0000-0001-8687-4486\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-1145-6199\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-1764-1993\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-2163-7903\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9057-6585\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-9288-5648\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-1114-1215\"}]},\"dataLinksTagsList\":{\"dataLinkstag\":[\"supporting_data\",\"related_data\"]},\"journalInfo\":{\"issue\":\"3\",\"volume\":\"27\",\"journalIssueId\":3915481,\"dateOfPublication\":\"2025 Mar\",\"monthOfPublication\":3,\"yearOfPublication\":2025,\"journal\":{\"medlineAbbreviation\":\"Nat Cell Biol\",\"title\":\"Nature cell biology\",\"essn\":\"1476-4679\",\"issn\":\"1465-7392\",\"isoabbreviation\":\"Nat Cell Biol\",\"nlmid\":\"100890575\"},\"printPublicationDate\":\"2025-03-01\"},\"pubYear\":\"2025\",\"pageInfo\":\"493-504\",\"abstractText\":\"Understanding how cells respond differently to perturbation is crucial in cell biology, but existing methods often fail to accurately quantify and interpret heterogeneous single-cell responses. Here we introduce the perturbation-response score (PS), a method to quantify diverse perturbation responses at a single-cell level. Applied to single-cell perturbation datasets such as Perturb-seq, PS outperforms existing methods in quantifying partial gene perturbations. PS further enables single-cell dosage analysis without needing to titrate perturbations, and identifies 'buffered' and 'sensitive' response patterns of essential genes, depending on whether their moderate perturbations lead to strong downstream effects. PS reveals differential cellular responses on perturbing key genes in contexts such as T cell stimulation, latent HIV-1 expression and pancreatic differentiation. Notably, we identified a previously unknown role for the coiled-coil domain containing 6 (CCDC6) in regulating liver and pancreatic cell fate decisions. PS provides a powerful method for dose-to-function analysis, offering deeper insights from single-cell perturbation data.\",\"affiliation\":\"Center for Genetic Medicine Research, Children's National Hospital, Washington, DC, USA.\",\"publicationStatus\":\"ppublish\",\"language\":\"eng\",\"pubModel\":\"Print-Electronic\",\"pubTypeList\":{\"pubType\":[\"research-article\",\"Journal Article\"]},\"grantsList\":{\"grant\":[{\"agency\":\"NCI NIH HHS\",\"acronym\":\"CA\",\"grantId\":\"P30 CA008748\",\"orderIn\":0},{\"agency\":\"U.S. Department of Health &amp; Human Services | NIH | National Human Genome Research Institute (NHGRI)\",\"grantId\":\"R01HG010753\",\"orderIn\":0},{\"agency\":\"NIGMS NIH HHS\",\"acronym\":\"GM\",\"grantId\":\"R35 GM140888\",\"orderIn\":0},{\"agency\":\"NHGRI NIH HHS\",\"acronym\":\"HG\",\"grantId\":\"U01 HG012051\",\"orderIn\":0},{\"agency\":\"National Science Foundation (NSF)\",\"grantId\":\"DBI-1846216, DMS-2113754\",\"orderIn\":0},{\"agency\":\"NIAID NIH HHS\",\"acronym\":\"AI\",\"grantId\":\"P30 AI117970\",\"orderIn\":0},{\"agency\":\"NIGMS NIH HHS\",\"acronym\":\"GM\",\"grantId\":\"T32 GM135083\",\"orderIn\":0},{\"agency\":\"U.S. Department of Health &amp; Human Services | NIH | National Human Genome Research Institute (NHGRI)\",\"grantId\":\"UM1HG012654, U01HG012051\",\"orderIn\":0},{\"agency\":\"U.S. Department of Health &amp; Human Services | NIH | National Heart, Lung, and Blood Institute (NHLBI)\",\"grantId\":\"R01HL168174\",\"orderIn\":0},{\"agency\":\"NHGRI NIH HHS\",\"acronym\":\"HG\",\"grantId\":\"UM1 HG012654\",\"orderIn\":0},{\"agency\":\"NHGRI NIH HHS\",\"acronym\":\"HG\",\"grantId\":\"R01 HG010753\",\"orderIn\":0},{\"agency\":\"NHLBI NIH HHS\",\"acronym\":\"HL\",\"grantId\":\"R01 HL168174\",\"orderIn\":0},{\"agency\":\"U.S. Department of Health &amp; Human Services | NIH | National Institute of General Medical Sciences (NIGMS)\",\"grantId\":\"R35GM140888\",\"orderIn\":0}]},\"meshHeadingList\":{\"meshHeading\":[{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Pancreas\",\"meshQualifierList\":{\"meshQualifier\":[{\"majorTopic_YN\":\"N\",\"abbreviation\":\"CY\",\"qualifierName\":\"cytology\"},{\"majorTopic_YN\":\"N\",\"abbreviation\":\"ME\",\"qualifierName\":\"metabolism\"}]}},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Animals\"},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Humans\"},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"HIV-1\",\"meshQualifierList\":{\"meshQualifier\":[{\"majorTopic_YN\":\"N\",\"abbreviation\":\"GE\",\"qualifierName\":\"genetics\"}]}},{\"majorTopic_YN\":\"N\",\"descriptorName\":\"Cell Differentiation\",\"meshQualifierList\":{\"meshQualifier\":[{\"majorTopic_YN\":\"N\",\"abbreviation\":\"GE\",\"qualifierName\":\"genetics\"}]}},{\"majorTopic_YN\":\"Y\",\"descriptorName\":\"Single-Cell Analysis\",\"meshQualifierList\":{\"meshQualifier\":[{\"majorTopic_YN\":\"N\",\"abbreviation\":\"MT\",\"qualifierName\":\"methods\"}]}}]},\"subsetList\":{\"subset\":[{\"code\":\"IM\",\"name\":\"Index Medicus\"}]},\"fullTextUrlList\":{\"fullTextUrl\":[{\"availability\":\"Open access\",\"availabilityCode\":\"OA\",\"documentStyle\":\"html\",\"site\":\"Unpaywall\",\"url\":\"https://escholarship.org/uc/item/80d1k93n\"},{\"availability\":\"Subscription required\",\"availabilityCode\":\"S\",\"documentStyle\":\"doi\",\"site\":\"DOI\",\"url\":\"https://doi.org/10.1038/s41556-025-01626-9\"},{\"availability\":\"Open access\",\"availabilityCode\":\"OA\",\"documentStyle\":\"html\",\"site\":\"Europe_PMC\",\"url\":\"https://europepmc.org/articles/PMC11906366\"},{\"availability\":\"Open access\",\"availabilityCode\":\"OA\",\"documentStyle\":\"pdf\",\"site\":\"Europe_PMC\",\"url\":\"https://europepmc.org/articles/PMC11906366?pdf=render\"}]},\"commentCorrectionList\":{\"commentCorrection\":[{\"source\":\"MED\",\"id\":\"37961332\",\"reference\":\"bioRxiv. 2023 Nov 29:2023.10.30.564796. doi: 10.1101/2023.10.30.564796.\",\"type\":\"Update of\",\"orderIn\":1}]},\"isOpenAccess\":\"Y\",\"inEPMC\":\"Y\",\"inPMC\":\"Y\",\"citedByCount\":34,\"hasReferences\":\"Y\",\"hasTextMinedTerms\":\"Y\",\"hasDbCrossReferences\":\"Y\",\"dbCrossReferenceList\":{\"dbName\":[\"EMBL\"]},\"hasPDF\":\"Y\",\"hasBook\":\"N\",\"hasSuppl\":\"Y\",\"hasLabsLinks\":\"Y\",\"hasData\":\"Y\",\"license\":\"cc by-nc-nd\",\"authMan\":\"N\",\"epmcAuthMan\":\"N\",\"nihAuthMan\":\"N\",\"hasTMAccessionNumbers\":\"Y\",\"tmAccessionTypeList\":{\"accessionType\":[\"gen\",\"doi\"]},\"dateOfCompletion\":\"2025-03-14\",\"dateOfCreation\":\"2025-02-26\",\"dateOfRevision\":\"2026-09-16\",\"electronicPublicationDate\":\"2025-02-26\",\"firstPublicationDate\":\"2025-02-26\",\"firstIndexDate\":\"2025-02-27\",\"fullTextReceivedDat