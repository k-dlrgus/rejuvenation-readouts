n: TRUE\r\n!Sample_characteristics_ch1 = donor body_mass_index: pooled: D1 - 34, D2 - 24.6, D3 - 22.7, D4 - 24.7\r\n!Sample_characteristics_ch1 = donor disease: normal\r\n!Sample_characteristics_ch1 = sample preservation_method: formaldehyde fixed -80C\r\n!Sample_characteristics_ch1 = donor ethnicity: pooled: D1 - Hispanic or Latin American, D2 - African American, D3 - African American, D4 - Asian\r\n!Sample_characteristics_ch1 = genetic perturbation_strategy: CRISPR interference\r\n!Sample_characteristics_ch1 = crispr system_type: constitutive\r\n!Sample_characteristics_ch1 = suspension enriched_cell_types: CD4-positive, alpha-beta T cell\r\n!Sample_characteristics_ch1 = suspension depletion_factors: EasySep™ Human Naïve CD4+ T Cell Isolation Kit: CD8,CD14,CD16,CD19,CD20,CD25,CD36,CD56,TCRgd,GlyA,CD61,CD66b,CD123,HLA-DR,CD45RO\r\n!Sample_characteristics_ch1 = library protocol: 10x Gene Expression Flex\r\n!Sample_characteristics_ch1 = sample probe_barcode: CD4i_R2L48_D1_Stim48hr : BC001+CR001|BC002+CR002|BC003+CR003|BC004+CR004, CD4i_R2L48_D2_Stim48hr : BC005+CR005|BC006+CR006|BC007+CR007|BC008+CR008, CD4i_R2L48_D3_Stim48hr : BC009+CR009|BC010+CR010|BC011+CR011|BC012+CR012, CD4i_R2L48_D4_Stim48hr : BC013+CR013|BC014+CR014|BC015+CR015|BC016+CR016\r\n!Sample_molecule_ch1 = polyA RNA\r\n!Sample_extract_protocol_ch1 = Naive human CD4+ T cells were isolated isolated with the EasySep Human Naive CD4+ T Cell Isolation Kit (catalog no. #19555, STEMCELL Technologies) according to the manufacturer’s protocol from PBMC-enriched leukapheresis products (Leukopaks, STEMCELL Technologies, catalog no. 70500) from healthy donors, after institutional review board–approved informed written consent (STEMCELL Technologies). After isolation (day 0), 30 million naive human CD4+ T cells were seeded at 1 x 106 cells/ml in X-VIVO 15 (Lonza Bioscience, catalog no. 04–418Q) supplemented with 5% fetal calf serum (FCS) (cXVIVO) and 200 IU/ml of recombinant human IL-2 (Amerisource Bergen, catalog no. 10101641). Cells were activated using ImmunoCult human CD3/CD28/CD2 T cell activator (10990, STEMCELL Technologies) at 25 µl/ml. The next morning, cells were transduced with 2% v/v concentrated ZIM3KRAB-dCas9-BlastR lentivirus. In the afternoon, cells were transduced with 0.1% v/v [multiplicity of infection (MOI) ~ 0.2] genome-scale sgRNA library lentivirus. At day 3, cells were centrifuged and resuspended with above medium supplemented with 200 IU/mL IL-2. Blasticidin and puromycin were added to 10 µg/mL and 2 µg/mL final concentrations, respectively. At day 5, cells were counted and diluted to 5 x 105 cells/mL with cXVIVO supplemented with 200 IU/mL IL-2 and 10 µg/mL blasticidin. Recombinant human IL-7 (R&D Systems, catalog no. 207-IL) was also added to a final concentration of 5 ng/mL. At day 7, cells were counted and diluted to 7.5 x 105 cells/mL with cXVIVO supplemented with 200 IU/mL IL-2, 5 ng/mL IL-7 and 10 µg/mL blasticidin. At both day 8 and day 10, cells were centrifuged and resuspended at 5 x 105 cells/mL with cXVIVO supplemented with 200 IU/mL IL-2 and 5 ng/mL IL-7. At day 12 morning, cells were centrifuged and resuspended at 1 x 106 cells/ml with cXVIVO supplemented with 200 IU/mL IL-2 and split into three populations. The first population (Rest) was kept at a resting state without restimulation and harvested in the afternoon after 8 hours. The second population (Stim8hr) was restimulated by adding 12.5 µL/ml ImmunoCult human CD3/CD28/CD2 T cell activator and harvested in the afternoon after 8 hours. The third population (Stim48hr) was restimulated by adding 12.5 µL/ml ImmunoCult human CD3/CD28/CD2 T cell activator and harvested after 48 hours.\r\n!Sample_extract_protocol_ch1 = GEM-X Flex Sample Preparation v2 Kit (10x genomics, catalog no. 1000781) per the manufacturer’s instructions\r\n!Sample_description = Library name: CD4i_R2L48_GEX_lib\r\n!Sample_data_processing = Raw data from pooled samples were processed by Cell Ranger v9.0.1 using the 2024-A probe set reference. UMI counts were demultiplexed back to each individual donor and stimulation condition using the barcodes in the sample_name: sample_probe_barcode metadata column.\r\n!Sample_data_processing = raw_matrix_genome_annotation:Chromium Human Transcriptome Probe Set v1.1.0: 2024-A , raw_matrix_value_units:UMI, raw_matrix_assays: scRNA-seq, CRISPR interference, raw_matrix_feature_keys:gene symbol for scRNA-seq, guide_id for CRISPR interference guides, raw_matrix_background_barcodes_included:False\r\n!Sample_data_processing = Assembly: GRCh38\r\n!Sample_data_processing = Supplementary files format and content: h5, count matrix: scRNA-seq and crispr guide UMI\r\n!Sample_platform_id = GPL34762\r\n!Sample_contact_name = Lattice,,Data Coordination\r\n!Sample_contact_email = lattice-info@lists.stanford.edu\r\n!Sample_contact_department = Genetics\r\n!Sample_contact_institute = Stanford University\r\n!Sample_contact_address = 3165 Porter Drive\r\n!Sample_contact_city = Palo Alto\r\n!Sample_contact_state = CA\r\n!Sample_contact_zip/postal_code = 94304\r\n!Sample_contact_country = USA\r\n!Sample_instrument_model = UG 100\r\n!Sample_library_selection = cDNA\r\n!Sample_library_source = transcriptomic single cell\r\n!Sample_library_strategy = RNA-Seq\r\n!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN54116565\r\n!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX31480009\r\n!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9393nnn/GSM9393898/suppl/GSM9393898_CD4i_R2L48_D1_Stim48hr_sample_filtered_feature_bc_matrix.h5\r\n!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9393nnn/GSM9393898/suppl/GSM9393898_CD4i_R2L48_D2_Stim48hr_sample_filtered_feature_bc_matrix.h5\r\n!Sample_supplementary_file_3 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9393nnn/GSM9393898/suppl/GSM9393898_CD4i_R2L48_D3_Stim48hr_sample_filtered_feature_bc_matrix.h5\r\n!Sample_supplementary_file_4 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9393nnn/GSM9393898/suppl/GSM9393898_CD4i_R2L48_D4_Stim48hr_sample_filtered_feature_bc_matrix.h5\r\n!Sample_series_id = GSE314342\r\n!Sample_data_row_count = 0\r\n^SAMPLE = GSM9481697\r\n!Sample_title = Donor 5 cells perturbed with GATA3 knockdown by CRISPRi\r\n!Sample_geo_accession = GSM9481697\r\n!Sample_status = Public on Feb 06 2026\r\n!Sample_submission_date = Jan 28 2026\r\n!Sample_last_update_date = Feb 06 2026\r\n!Sample_type = SRA\r\n!Sample_channel_count = 1\r\n!Sample_source_name_ch1 = blood\r\n!Sample_organism_ch1 = Homo sapiens\r\n!Sample_taxid_ch1 = 9606\r\n!Sample_characteristics_ch1 = tissue: blood\r\n!Sample_characteristics_ch1 = cell type: CD4-positive, alpha-beta T cells\r\n!Sample_characteristics_ch1 = treatment: ImmunoCult™ Human CD3/CD28/CD2 T Cell Activator\r\n!Sample_characteristics_ch1 = experimental perturbation: CRISPRi knockdown of GATA3\r\n!Sample_characteristics_ch1 = donor id: CE0009596\r\n!Sample_characteristics_ch1 = donor age: 30\r\n!Sample_characteristics_ch1 = donor weight: 121\r\n!Sample_characteristics_ch1 = donor height: 180\r\n!Sample_characteristics_ch1 = donor smoker: No\r\n!Sample_characteristics_ch1 = donor blood_type: O+\r\n!Sample_characteristics_ch1 = anticoagulant: ACDA\r\n!Sample_characteristics_ch1 = source: STEMCELL technologies\r\n!Sample_characteristics_ch1 = donor sex: Male\r\n!Sample_characteristics_ch1 = donor dev_stage: adult stage\r\n!Sample_characteristics_ch1 = donor living_at_sample_collection: TRUE\r\n!Sample_characteristics_ch1 = donor body_mass_index: 37.35\r\n!Sample_characteristics_ch1 = donor disease: Normal\r\n!Sample_characteristics_ch1 = sample preservation_method: Zymo DNA/RNA Shield\r\n!Sample_characteristics_ch1 = suspension depletion_factors: EasySep™ Human Naïve CD4+ T Cell Isolation Kit: CD8,CD14,CD16,CD19,CD20,CD25,CD36,CD56,TCRgd,GlyA,CD61,CD66b,CD123,HLA-DR,CD45RO\r\n!Sample_characteristics_ch1 = donor ethnicity: Caucasian\r\n!Sample_characteristics_ch1 = genetic perturbation_strategy: CRISPRi\r\n!Sample_characteristics_ch1 = enriched cell_types: CD4-positive, alpha-beta T cells\r\n!Sample_characteristics_ch1 = library protocol: Plasmidsaurus RNA-Seq\r\n!Sample_treatment_protocol_ch1 = 200 IU/mL IL-2 and 12.5 µL/mL ImmunoCult human CD3/CD28/CD2 T cell activator for 8 hours\r\n!Sample_growth_protocol_ch1 = Naive human CD4+ T cells were isolated isolated with the EasySep Human Naive CD4+ T Cell Isolation Kit (catalog no. #19555, STEMCELL Technologies) according to the manufacturer’s protocol from PBMC-enriched leukapheresis products (Leukopaks, STEMCELL Technologies, catalog no. 70500) from healthy donors, after institutional review board–approved informed written consent (STEMCELL Technologies). At day 0, primary naive human CD4+ T cells were seeded at 1 x 106 cells/ml in cXVIVO and 200 IU/ml IL-2 at 150µL/well in 96-well flat bottom plates. Cells were activated using ImmunoCult human CD3/CD28/CD2 T cell activator at 25 µl/ml. The next morning, cells were transduced with 2% v/v concentrated ZIM3KRAB-dCas9-BlastR lentivirus. In the afternoon, cells in each well were transduced with a distinct, individual single gRNA expressing lentivirus at 2% v/v. On day 3, cells were split to ~5 x 105 cells/mL and Blasticidin was added at 10 µg/mL final concentration. At day 5, cells were centrifuged and resuspended with cXVIVO supplemented with 200 IU/mL IL-2, 5 ng/mL IL-7 and 10 µg/mL blasticidin at ~5 x 105 cells/mL. At day 7, cells were counted and diluted to 1 x 106 cells/mL with cXVIVO supplemented with 200 IU/mL IL-2, 5 ng/mL IL-7 and 10 µg/mL blasticidin. At day 8, cells were centrifuged and resuspended at 1 x 106 cells/mL with cXVIVO supplemented with 200 IU/mL IL-2 and 5 ng/mL IL-7. On day 10 morning, cells were centrifuged and resuspended at 2 x 106 cells/ml with cXVIVO supplemented with 200 IU/mL IL-2 and 12.5 µL/mL ImmunoCult human CD3/CD28/CD2 T cell activator for 8 hours.\r\n!Sample_molecule_ch1 = polyA RNA\r\n!Sample_extract_protocol_ch1 = Cells were centrifuged and resuspended in DNA/RNA Shield (Zymo Research) and sent for bulk RNAseq by Plasmidsaurus.\r\n!Sample_extract_protocol_ch1 = plasmidsaurus library preparation - conversion of mRNA into complementary DNA via reverse transcription and second-strand synthesis, followed by tagmentation, library indexing, and amplification.\r\n!Sample_description = Library name: Donor5_GATA3\r\n!Sample_data_processing = Quality of the fastq files was assessed using FastQC v0.12.1. Reads were then quality filtered using fastp v0.24.0 with poly-X tail trimming, 3' quality-based tail trimming, a minimum Phred quality score of 15, and a minimum length requirement of 50 bp. Quality-filtered reads were aligned to the reference genome using STAR aligner v2.7.11 with non-canonical splice junction removal and output of unmapped reads, followed by coordinate sorting using samtools v1.22.1. PCR and optical duplicates were removed using UMI-based deduplication with UMIcollapse v1.1.0. Alignment quality metrics, strand specificity, and read distribution across genomic features were assessed using RSeQC v5.0.4 and Qualimap v2.3, with results aggregated into a comprehensive quality control report using MultiQC v1.32. Gene-level expression quantification was performed using featureCounts (subread package v2.1.1) with strand-specific counting, multi-mapping read fractional assignment, exons and three prime UTR as the feature identifiers, and grouped by gene_id. Final gene counts were annotated with gene biotype and other metadata extracted from the reference GTF file.\r\n!Sample_data_processing = Assembly: GRCh38, GENCODE48\r\n!Sample_data_processing = Supplementary files format and content: processed data format:csv, processed data content: raw counts, normalized counts (CPM)\r\n!Sample_platform_id = GPL34284\r\n!Sample_contact_name = Lattice,,Data Coordination\r\n!Sample_contact_email = lattice-info@lists.stanford.edu\r\n!Sample_contact_department = Genetics