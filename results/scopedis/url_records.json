  "text": "{\"version\":\"6.9\",\"hitCount\":1,\"request\":{\"queryString\":\"EXT_ID:39663454\",\"resultType\":\"core\",\"cursorMark\":\"*\",\"pageSize\":25,\"sort\":\"\",\"synonym\":false},\"resultList\":{\"result\":[{\"id\":\"39663454\",\"source\":\"MED\",\"pmid\":\"39663454\",\"pmcid\":\"PMC11754113\",\"fullTextIdList\":{\"fullTextId\":[\"PMC11754113\"]},\"doi\":\"10.1038/s41586-024-08314-y\",\"title\":\"Central control of dynamic gene circuits governs T cell rest and activation.\",\"authorString\":\"Arce MM, Umhoefer JM, Arang N, Kasinathan S, Freimer JW, Steinhart Z, Shen H, Pham MTN, Ota M, Wadhera A, Dajani R, Dorovskyi D, Chen YY, Liu Q, Zhou Y, Swaney DL, Obernier K, Shy BR, Carnevale J, Satpathy AT, Krogan NJ, Pritchard JK, Marson A.\",\"authorList\":{\"author\":[{\"fullName\":\"Arce MM\",\"lastName\":\"Arce\",\"firstName\":\"Maya M\",\"initials\":\"MM\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0003-4234-9908\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Gladstone-UCSF Institute of Genomic Immunology, San Francisco, CA, USA.\"},{\"affiliation\":\"Department of Medicine, University of California, San Francisco, CA, USA.\"},{\"affiliation\":\"Biomedical Sciences graduate program, University of California, San Francisco, CA, USA.\"}]}},{\"fullName\":\"Umhoefer JM\",\"lastName\":\"Umhoefer\",\"firstName\":\"Jennifer M\",\"initials\":\"JM\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0002-8563-9641\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Gladstone-UCSF Institute of Genomic Immunology, San Francisco, CA, USA.\"},{\"affiliation\":\"Department of Medicine, University of California, San Francisco, CA, USA.\"},{\"affiliation\":\"Biomedical Sciences graduate program, University of California, San Francisco, CA, USA.\"}]}},{\"fullName\":\"Arang N\",\"lastName\":\"Arang\",\"firstName\":\"Nadia\",\"initials\":\"N\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliatio