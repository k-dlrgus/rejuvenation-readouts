ord.edu\r\n!Sample_contact_department = Genetics\r\n!Sample_contact_institute = Stanford University\r\n!Sample_contact_address = 3165 Porter Drive\r\n!Sample_contact_city = Palo Alto\r\n!Sample_contact_state = CA\r\n!Sample_contact_zip/postal_code = 94304\r\n!Sample_contact_country = USA\r\n!Sample_instrument_model = Illumina NovaSeq X Plus\r\n!Sample_library_selection = cDNA\r\n!Sample_library_source = transcriptomic\r\n!Sample_library_strategy = RNA-Seq\r\n!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN60451832\r\n!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX33640067\r\n!Sample_supplementary_file_1 = NONE\r\n!Sample_series_id = GSE314342\r\n!Sample_data_row_count = 0\r\n^SAMPLE = GSM9774584\r\n!Sample_title = DonorH cells perturbed with LAT knockdown by CRISPRi in batch Rep2 collected 48 hrs after restimulation\r\n!Sample_geo_accession = GSM9774584\r\n!Sample_status = Public on Jun 02 2026\r\n!Sample_submission_date = May 29 2026\r\n!Sample_last_update_date = Jun 02 2026\r\n!Sample_type = SRA\r\n!Sample_channel_count = 1\r\n!Sample_source_name_ch1 = blood\r\n!Sample_organism_ch1 = Homo sapiens\r\n!Sample_taxid_ch1 = 9606\r\n!Sample_characteristics_ch1 = tissue: blood\r\n!Sample_characteristics_ch1 = cell type: CD4-positive, alpha-beta T cells\r\n!Sample_characteristics_ch1 = treatment: 48 hour ImmunoCult™ Human CD3/CD28/CD2 T Cell Activator\r\n!Sample_characteristics_ch1 = experimental perturbation: CRISPRi knockdown of LAT\r\n!Sample_characteristics_ch1 = donor id: CE0011304\r\n!Sample_characteristics_ch1 = donor age: 29\r\n!Sample_characteristics_ch1 = donor weight: 94\r\n!Sample_characteristics_ch1 = donor height: 183\r\n!Sample_characteristics_ch1 = donor smoker: Yes\r\n!Sample_characteristics_ch1 = donor blood_type: A-\r\n!Sample_characteristics_ch1 = anticoagulant: ACDA\r\n!Sample_characteristics_ch1 = source: STEMCELL technologies\r\n!Sample_characteristics_ch1 = donor sex: Male\r\n!Sample_characteristics_ch1 = 