niversity of Melbourne, Parkville, VIC, Australia.\"},{\"affiliation\":\"Bruce Lefroy Centre, Murdoch Children's Research Institute, Parkville, VIC, Australia.\"}]}},{\"fullName\":\"Pope K\",\"lastName\":\"Pope\",\"firstName\":\"Kate\",\"initials\":\"K\",\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Bruce Lefroy Centre, Murdoch Children's Research Institute, Parkville, VIC, Australia.\"}]}},{\"fullName\":\"Lockhart PJ\",\"lastName\":\"Lockhart\",\"firstName\":\"Paul J\",\"initials\":\"PJ\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0003-2531-8413\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Paediatrics, University of Melbourne, Parkville, VIC, Australia.\"},{\"affiliation\":\"Bruce Lefroy Centre, Murdoch Children's Research Institute, Parkville, VIC, Australia.\"}]}},{\"fullName\":\"Girirajan S\",\"lastName\":\"Girirajan\",\"firstName\":\"Santhosh\",\"initials\":\"S\",\"authorId\":{\"type\":\"ORCID\",\"value\":\"0000-0003-0598-4945\"},\"authorAffiliationDetailsList\":{\"authorAffiliation\":[{\"affiliation\":\"Department of Biochemistry and Molecular Biology, Pennsylvania State University, University Park, PA, USA. sxg47@psu.edu.\"},{\"affiliation\":\"Huck Institutes of the Life Sciences, University Park, PA, USA. sxg47@psu.edu.\"}]}}]},\"authorIdList\":{\"authorId\":[{\"type\":\"ORCID\",\"value\":\"0000-0001-7191-8511\"},{\"type\":\"ORCID\",\"value\":\"0000-0002-4681-1074\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-0598-4945\"},{\"type\":\"ORCID\",\"value\":\"0000-0003-2531-8413\"},{\"type\":\"ORCID\",\"value\":\"0009-0000-7904-5145\"},{\"type\":\"ORCID\",\"value\":\"0009-0000-9019-7385\"},{\"type\":\"ORCID\",\"value\":\"0009-0003-6486-035X\"},{\"type\":\"ORCID\",\"value\":\"0009-0008-0113-5325\"}]},\"dataLinksTagsList\":{\"dataLinkstag\":[\"altmetrics\",\"supporting_data\"]},\"journalInfo\":{\"issue\":\"1\",\"volume\":\"17\",\"journalIssueId\":4187584,\"dateOfPublication\":\"2026 May\",\"monthOfPublication\":5,\"yearOfPublication\":2026,\"journal\":{\"medlineAbbreviation\":\"Nat Commun\",\"title\":\"Nature communications\",\"essn\":\"2041-1723\",\"issn\":\"2041-1723\",\"isoabbreviation\":\"Nat Commun\",\"nlmid\":\"101528555\"},\"printPublicationDate\":\"2026-05-01\"},\"pubYear\":\"2026\",\"pageInfo\":\"5917\",\"abstractText\":\"Disease-associated variants can lead to variable phenotypic outcomes in neurodevelopmental disorders, but the biological mechanisms underlying this variability remain poorly understood. Here, we develop a framework to investigate this phenomenon using the 16p12.1 deletion as a paradigm of variable expressivity. Using induced pluripotent stem cell models from affected families and CRISPR-edited lines with the 16p12.1 deletion, we find that the deletion and rare variants in the genetic background jointly influence chromatin accessibility and expression of neurodevelopmental genes. Cellular analyses identify family-specific phenotypes, including altered inhibitory neuron production and neural progenitor cell proliferation, which correlate with head-size variation. CRISPR activation of individual 16p12.1 genes variably rescue these defects by modulating key developmental signaling pathways. Integrative analyses further identify regulatory hubs, including transcription factors FOXG1 and JUN, as mediators of these effects. Our study provides a functional framework for investigating how individual genetic architectures contribute to phenotypic variability in neurodevelopmental disorders.\",\"affiliation\":\"Department of Biochemistry and Molecular Biology, Pennsylvania State University, University Park, PA, USA.\",\"publicationStatus\":\"epublish\",\"language\":\"eng\",\"pubModel\":\"Electronic\",\"pubTypeList\":{\"pubType\":[\"research-article\",\"Journal Article\"]},\"grantsList\":{\"grant\":[{\"agency\":\"U.S. Department of Health & Human Services | NIH | National Institute of General Medical Sciences (NIGMS)\",\"grantId\