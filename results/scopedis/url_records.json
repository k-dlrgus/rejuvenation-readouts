nt = Computational Biology\r\n!Sample_contact_institute = Fred Hutchinson Cancer Center\r\n!Sample_contact_address = 1100 Fairview Ave N\r\n!Sample_contact_city = Seattle\r\n!Sample_contact_state = WA\r\n!Sample_contact_zip/postal_code = 98109\r\n!Sample_contact_country = USA\r\n!Sample_instrument_model = Illumina NovaSeq X Plus\r\n!Sample_library_selection = cDNA\r\n!Sample_library_source = transcriptomic\r\n!Sample_library_strategy = RNA-Seq\r\n!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN49651035\r\n!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX29399037\r\n!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9070nnn/GSM9070972/suppl/GSM9070972_IP3_2_gene_counts.txt.gz\r\n!Sample_supplementary_file_2 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9070nnn/GSM9070972/suppl/GSM9070972_IP3_2_gene_counts_fpkm.txt.gz\r\n!Sample_series_id = GSE300879\r\n!Sample_data_row_count = 0\r\n",
