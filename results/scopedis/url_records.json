c 01 2025\r\n!Sample_last_update_date = Apr 18 2026\r\n!Sample_type = SRA\r\n!Sample_channel_count = 1\r\n!Sample_source_name_ch1 = bone marrow\r\n!Sample_organism_ch1 = Mus musculus\r\n!Sample_taxid_ch1 = 10090\r\n!Sample_characteristics_ch1 = tissue: bone marrow\r\n!Sample_characteristics_ch1 = cell line: BMDMs\r\n!Sample_characteristics_ch1 = cell type: BMDMs\r\n!Sample_treatment_protocol_ch1 = On day 10 of differentiation, cells were stimulated with lipopolysaccharide (LPS, 100 ng/ml) for 9 hours prior to collection for scRNA-seq.\r\n!Sample_growth_protocol_ch1 = Bone marrow cells were isolated from tibias and femurs of 6–12 week old Cas9 transgenic mice. Cells were cultured in DMEM supplemented with 10% heat-inactivated fetal bovine serum, GlutaMAX, penicillin/streptomycin, and 100 ng/ml recombinant mouse M-CSF to differentiate into bone marrow–derived macrophages (BMDMs).\r\n!Sample_molecule_ch1 = polyA RNA\r\n!Sample_extract_protocol_ch1 = Following stimulation, cells were dissociated with Accutase and AccuMAX, washed, and prepared for single-cell encapsulation. Cellular RNA was extracted in droplet format using the 10x Genomics Chromium GEM-X chemistry according to manufacturer’s instructions.\r\n!Sample_extract_protocol_ch1 = Single-cell RNA-seq libraries were constructed using the 10x Genomics Single Cell 3’ GEM-X kit. Libraries were indexed and sequenced on an Illumina NextSeq 2000 platform with 100 bp paired-end reads.\r\n!Sample_description = Library name: LIB6297172_SAM24539795_lane2\r\n!Sample_data_processing = Raw reads were processed using Cell Ranger v7.0.0 with default parameters.\r\n!Sample_data_processing = Reads were aligned to the mm10 reference genome.\r\n!Sample_data_processing = Perturbation assignment was performed by demultiplexing gRNA barcodes with kallisto/bustools/kite.\r\n!Sample_data_processing = Assembly: Mus musculus mm10 reference genome.\r\n!Sample_data_processing = Supplementary files format and content: Processed data files are provided in Matrix Market (.mtx) format with accompanying feature and barcode annotation files (.tsv) for single-cell counts. In addition, perturbation assignment tables and processed gene expression matrices are provided as .csv and .h5ad (AnnData) formats for downstream analysis.\r\n!Sample_data_processing = Library strategy: CITE-seq\r\n!Sample_platform_id = GPL13112\r\n!Sample_contact_name = Romain,,Lopez\r\n!Sample_contact_institute = New York University\r\n!Sample_contact_address = 1396 Sanchez St\r\n!Sample_contact_city = San Francisco\r\n!Sample_contact_state = California\r\n!Sample_contact_zip/postal_code = 94131\r\n!Sample_contact_country = USA\r\n!Sample_instrument_model = Illumina HiSeq 2000\r\n!Sample_library_selection = other\r\n!Sample_library_source = transcriptomic\r\n!Sample_library_strategy = OTHER\r\n!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN53501585\r\n!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX31271533\r\n!Sample_supplementary_file_1 = ftp://ftp.ncbi.nlm.nih.gov/geo/samples/GSM9337nnn/GSM9337870/suppl/GSM9337870_LIB6297172_SAM24539795.citeseq.umi_correct.h5\r\n!Sample_series_id = GSE312107\r\n!Sample_data_row_count = 0\r\n",
